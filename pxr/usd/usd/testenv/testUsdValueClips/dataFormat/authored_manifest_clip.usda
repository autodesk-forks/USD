    float aTimeSamplesNonEmptyClip.timeSamples = { 1: 1 }
    float aTimeSamplesPreActiveTime.timeSamples = {
        -2: -2,
        -1: -1,
        0: 0,
    }

    float aSplineNonEmptyClip.spline = {1:1; post held}
