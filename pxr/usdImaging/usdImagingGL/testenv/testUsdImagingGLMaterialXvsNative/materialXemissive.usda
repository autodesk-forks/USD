#usda 1.0
(
    upAxis = "Z"
)

def Scope "UsdMaterialX" {
    def Sphere "MxUsdEmissive_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MxMaterials/USD_Emissive_01>
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.8)]
        double3 xformOp:translate = (-5.0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "MxUsdEmissive_02" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MxMaterials/USD_Emissive_02>
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.8)]
        double3 xformOp:translate = (-2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "MxUsdEmissive_03" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MxMaterials/USD_Emissive_03>
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.8)]
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "MxUsdEmissive_04" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MxMaterials/USD_Emissive_04>
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.8)]
        double3 xformOp:translate = (2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "MxUsdEmissive_05" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MxMaterials/USD_Emissive_05>
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.8)]
        double3 xformOp:translate = (5.0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}


def Scope "MxMaterials" {
    def Material "USD_Emissive_01" {
        token outputs:mtlx:surface.connect = </MxMaterials/USD_Emissive_01/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.7, 0.2, 0.0)
            color3f inputs:emissiveColor = (0.2, 0.7, 0.)
            float inputs:roughness = 0.0

            token outputs:surface
        }
    }
    def Material "USD_Emissive_02" {
        token outputs:mtlx:surface.connect = </MxMaterials/USD_Emissive_02/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.7, 0.2, 0.0)
            color3f inputs:emissiveColor = (0.2, 0.7, 0.)
            float inputs:roughness = 0.25

            token outputs:surface
        }
    }
    def Material "USD_Emissive_03" {
        token outputs:mtlx:surface.connect = </MxMaterials/USD_Emissive_03/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.7, 0.2, 0.0)
            color3f inputs:emissiveColor = (0.2, 0.7, 0.)
            float inputs:roughness = 0.5

            token outputs:surface
        }
    }
    def Material "USD_Emissive_04" {
        token outputs:mtlx:surface.connect = </MxMaterials/USD_Emissive_04/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.7, 0.2, 0.0)
            color3f inputs:emissiveColor = (0.2, 0.7, 0.)
            float inputs:roughness = 0.75

            token outputs:surface
        }
    }
    def Material "USD_Emissive_05" {
        token outputs:mtlx:surface.connect = </MxMaterials/USD_Emissive_05/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.7, 0.2, 0.0)
            color3f inputs:emissiveColor = (0.2, 0.7, 0.)
            float inputs:roughness = 1.0

            token outputs:surface
        }
    }
}

def Xform "lights" {
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = @./StinsonBeach.hdr@
        float xformOp:rotateX:Zup = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:Zup"]
    }
}

def Camera "Camera" {
    double3 xformOp:translate = (0, 0, 35)
    float xformOp:rotateX:Zup = 90
    uniform token[] xformOpOrder = ["xformOp:rotateX:Zup","xformOp:translate"]
}