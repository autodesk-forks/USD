def "ModelMissingWithNoManifestDefaults" (
    references = @./refMissing.usda@</Model>
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./missing_clip0.usda@, @./missing_clip1.usda@,
                                  @./missing_clip2.usda@, @./missing_clip3.usda@]
            string primPath = "/Model"
            double2[] active = [(0.0, 0.0), (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)]
            asset manifestAssetPath = @./manifest_with_no_defaults.usda@
        }
    }
)
{
}

