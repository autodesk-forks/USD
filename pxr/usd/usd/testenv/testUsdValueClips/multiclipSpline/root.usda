def "ModelWithNoTimes" (
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./clip1.usda@, @./clip2.usda@, @./clip3.usda@]
            string primPath = "/Model"
            double2[] active = [(0, 0), (10, 1), (20, 2)]
        }
    }
)
{
    double attrDualValuedBoundary
    double attrTruncatedLooping
}

def "ModelWithTimesSpanningClips" (
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./spanning_clip1.usda@, @./spanning_clip2.usda@]
            string primPath = "/Model"
            double2[] active = [(0, 0), (10, 1)]

            double2[] times = [
                (0, 0),
                (5, 10),  # clip sped up 2x
                (15, 15), # clips slowed down 2x, changes to clip2
                (20, 25)  # clip sped up 2x
            ]
        }
    }
)
{
    double attr1
    double attr2
    double attr3
    double attr4
}