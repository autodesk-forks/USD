                interpolation = "faceVarying"
            )
            int[] primvars:normals:indices = [0, 2, 4, 6, 1, 3, 5, 7, 0, 1, 2, 3]

            uniform token subdivisionScheme = "none"

            float3 xformOp:translate = (-3, 0, 6.5)
            float3 xformOp:scale = (0.6, 0.6, 0.6)
            float xformOp:rotateX = 90
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
            uniform token faceVaryingLinearInterpolation = "none"
        }

        def Mesh "PolygonMesh2" 
        {
