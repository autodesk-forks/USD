#usda 1.0

def "Model" (
    references = @./ref.usda@</Model>

    clips = {
        dictionary default = {
            asset[] assetPaths = [@./clip.usda@]
            string primPath = "/Model"
            double2[] active = [(0.0, 0)]
            # Descriptions indicate behavior of the time segment
            # described by the current and previous time tuples
            double2[] times = [
                (0, 10),
                (10, 20), # offset, no scale
                (10, 10), # jump discontinuity
                (20, 15), # slowed down 2x
                (25, 25), # sped up 2x
                (29.5, 16)  # reversed and sped up 2x
            ]
        }
    }
)
{
}

def "Model2" (
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./clip.usda@]
            string primPath = "/Model"
            double2[] active = [(0.0, 0)]
            double2[] times = [
                (10, 10),
                (15, 5),  # reversed section
                (15, 0), # jump discontinuity
                (20, 5)
            ]
        }
    }   
)
{
    double attr2
    double attr3
}