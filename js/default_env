# This is the folder that contains the models which are to be used for benchmarking
# We only serve models with the extension .usd, .usdz and .usda
BENCHMARK_MODELS_FOLDER=<Folder to usd models>
# This is the port that the USDView web server will run on
USDVIEWWEB_LOCAL_PORT=8000
# This is a list of filters to apply to the models in the BENCHMARK_MODELS_FOLDER for running the benchmark.
# It should not include the extension, only the filename
FILTERED_MODELS=model1,model2,model3
# Resolutions to use for the benchmark
#BENCHMARK_RESOLUTIONS_SUBSET = '1080p'
